# Root ignores. The app is Flutter and lives in flutter/, which has its own
# .gitignore for everything Dart/Flutter-specific. Keep this file about the
# repo root only.

# dependencies
node_modules/

# Signing material and keys — never commit, regardless of which toolchain.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# macOS
.DS_Store

# local env files
.env
.env*.local

# Git worktrees (superpowers)
.worktrees/
.gstack/

# Agent/tool config — machine-local, never commit.
# .mcp.json carries live service credentials (OneSignal app id + REST API key).
# It reached a commit once already, on the unpushed backup-feat-hard-paywall
# branch (2dd0258, 2026-06-03); this line is what stops the next `git add .`.
.mcp.json
.claude/settings.local.json
.claude/worktrees/

# App Store screenshot generator — scaffolded on demand by the
# `app-store-screenshots` skill, and 368M of it is node_modules.
screenshots-app/
